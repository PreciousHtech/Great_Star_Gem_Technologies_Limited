# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection URI (e.g., Supabase transaction pooler or direct connection).
# Users configure this via the Settings / Secrets panel in the AI Studio UI.
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# ADMIN_PASSWORD: Initial default password for the admin account before any manual change is made.
# When the admin updates the password in Security Settings, the custom password takes precedence
# and is persisted to the database, superseding this environment default.
ADMIN_PASSWORD=

# ADMIN_USERNAME: Initial administrator username.
ADMIN_USERNAME=

# ADMIN_RECOVERY_KEY: Master emergency recovery key to reset admin credentials if password or 2FA is lost.
# Can be any secure phrase (e.g. MySecretRecoveryKey2026).
ADMIN_RECOVERY_KEY=

# =============================================================================
# SUPABASE STORAGE CONFIGURATION (Media & Proof-of-Work Videos CDN)
# =============================================================================
# SUPABASE_URL: Your Supabase Project API URL (e.g., https://[project-ref].supabase.co).
# If omitted, this is automatically inferred from the project ref inside your DATABASE_URL.
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co

# SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY: The Supabase API key for authenticating storage requests.
# Find this in your Supabase Dashboard under: Project Settings -> API -> Project API keys.
# - SUPABASE_ANON_KEY (Public Key with RLS storage policies)
# - or SUPABASE_SERVICE_ROLE_KEY (Bypasses RLS to reliably create buckets and upload media)
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SUPABASE_STORAGE_BUCKET: Name of the Supabase Storage bucket to use (defaults to 'media' if unset).
# Buckets are automatically verified and created if using SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_STORAGE_BUCKET=
